<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="15dp"
    android:background="@drawable/bg_rounded_gray_border_shadow"
   >

        <TextView
            android:id="@+id/txtNameFood"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Item_ProblemDish_titleFood"
            android:textStyle="bold"
            android:textSize="16sp"/>
        <TextView
            android:id="@+id/txtIssueMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Item_ProblemDish_issueMessage"
            android:textSize="15sp"
            android:layout_marginTop="5dp"
            android:textColor="#BF6666"/>

</LinearLayout>